# Opcionales para arrancar. Completar SOLO en .env.local o en el gestor de secretos.
# Proyecto Supabase independiente de Argentoma. URL HTTPS del proyecto.
SUPABASE_URL=
# Clave secreta del backend; nunca NEXT_PUBLIC_ ni compartir por chat.
SUPABASE_SECRET_KEY=
# Reservada para el futuro adaptador. Todavía no se consulta API-Football.
API_FOOTBALL_API_KEY=
# BSD/Bzzoiro: clave privada para validar cobertura desde backend.
BSD_API_KEY=
# Selección backend del equipo y frescura de la vista de registros (no vivo).
FOOTBALL_PROVIDER=
FOOTBALL_TEAM_ID=
FIXTURES_STALE_AFTER_SECONDS=
# Home en vivo: mantener false hasta activar SQL, worker y lectura auditada.
LIVE_HOME_ENABLED=false

# Opcional: clave backend para scripts/check-goal.mjs --dry-run (Copa Argentina).
# Configurar solo en .env.local, conservando BSD_API_KEY.
GOAL_API_KEY=

# Lectura de estadísticas: history (default) o projection.
# NO activar projection hasta aplicar propuesta SQL, reconstruir todos los fixtures
# BSD servidos y verificar equivalencia/permisos/concurrencia. No hay fallback.
STATISTICS_READ_MODE=history

# Alineaciones: mantener history hasta corte, auditoría y reconstrucción completos.
LINEUPS_READ_MODE=history

# Eventos: history por defecto; projection requiere activacion por entorno.
INCIDENTS_READ_MODE=history
