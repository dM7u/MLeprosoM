        "name": "team_statistics_observations_check1",
        "validated": true,
        "definition": "CHECK ((((status = 'failed'::text) AND (payload IS NULL)) OR ((status <> 'failed'::text) AND (payload IS NOT NULL) AND (((jsonb_typeof(payload) = 'object'::text) AND ((payload ->> 'provider'::text) = provider) AND ((payload ->> 'event_id'::text) = external_id) AND ((payload ->> 'state'::text) = status) AND ((payload ->> 'period'::text) = 'full_match'::text) AND ((payload -> 'version'::text) = '1'::jsonb) AND (jsonb_typeof((payload -> 'home'::text)) = 'object'::text) AND (jsonb_typeof((payload -> 'away'::text)) = 'object'::text) AND (((payload ->> 'fetched_at'::text))::timestamp with time zone = observed_at)) IS TRUE))))"
      },
